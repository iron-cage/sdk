# Database setup (needs read/write for spending tracking)
DATABASE_URL=sqlite:///var/lib/iron_cage/iron_cage.db

# Security
# Base64-encoded 32-byte AES-256-GCM key for provider key decryption.
# Must be the SAME value as IRON_SECRETS_MASTER_KEY in iron_control_api.
# Generate: openssl rand -base64 32
IRON_SECRETS_MASTER_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
# Note: IP_TOKEN_KEY is used by iron_control_api, not iron_server_proxy.
# See deploy/env/iron_control_api.env.example for IC token key configuration.

# Server settings
BIND_ADDR=127.0.0.1
PROXY_PORT=8081
RUST_LOG=info
