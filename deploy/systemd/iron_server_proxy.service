[Unit]
Description=Iron Cage Server-Side LLM Proxy
After=network.target iron_control_api.service
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=simple
User=ironcage
Group=ironcage
WorkingDirectory=/var/lib/iron_cage
ExecStart=/usr/local/bin/iron_server_proxy
Restart=on-failure
RestartSec=5
TimeoutStopSec=300
EnvironmentFile=/etc/iron_cage/iron_server_proxy.env

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/iron_cage
ProtectHome=yes

[Install]
WantedBy=multi-user.target
